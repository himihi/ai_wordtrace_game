/* ========== 全局设计变量（明快卡通） ========== */
page {
  --brand: #ff8a3d;        /* 品牌主色·橙 */
  --brand-deep: #f0692a;
  --accent: #ffd93d;       /* 辅助·糖果黄 */
  --success: #4ecdc4;      /* 成功·青绿 */
  --danger: #ff6b6b;       /* 错误·红 */
  --ink: #3d3a50;          /* 正文·深灰紫 */
  --ink-light: #8b879e;
  --card: #ffffff;
  --radius-lg: 24rpx;
  --radius-md: 16rpx;
  --shadow-card: 0 8rpx 24rpx rgba(61, 58, 80, 0.08);
  --shadow-btn: 0 6rpx 0 rgba(240, 105, 42, 0.55);

  background: linear-gradient(180deg, #fff7e6 0%, #ffe8d6 100%);
  background-attachment: fixed;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
  min-height: 100%;
}

/* ========== 通用组件 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: transform 0.08s ease;
}
.btn:active {
  transform: scale(0.96);
}

.btn-primary {
  background: linear-gradient(135deg, #ffa25e 0%, var(--brand) 60%, var(--brand-deep) 100%);
  color: #fff;
  box-shadow: var(--shadow-btn);
}

.btn-ghost {
  background: #fff;
  color: var(--brand-deep);
  border: 4rpx solid #ffd8b8;
}

/* 页面淡入 */
@keyframes page-fade {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.page-fade {
  animation: page-fade 0.35s ease both;
}

/* 通用漂浮装饰 */
@keyframes float-y {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-14rpx); }
}

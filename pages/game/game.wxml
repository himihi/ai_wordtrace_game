<view class="page page-fade">
  <!-- 顶部：关卡徽章 + 重开 + 提示 -->
  <view class="topbar">
    <view class="level-badge">第 {{levelId}} 关</view>
    <view class="topbar-right">
      <view class="icon-btn" bindtap="onSave">
        <text class="icon-btn-emoji">💾</text>
      </view>
      <view class="icon-btn" bindtap="onToggleMusic">
        <text class="icon-btn-emoji">{{musicOn ? '🎵' : '🔇'}}</text>
      </view>
      <view class="icon-btn" bindtap="onRestart">
        <text class="icon-btn-emoji">🔄</text>
      </view>
      <view class="hint-btn {{hintLocked || hintLeft <= 0 ? 'hint-btn-disabled' : ''}}" bindtap="onHint">
        <text wx:if="{{hintLocked}}">🔒 休息中</text>
        <text wx:else>💡 提示</text>
        <text class="hint-count">{{hintLocked ? hintLockSec : hintLeft}}</text>
      </view>
    </view>
  </view>

  <!-- 四格填空 -->
  <view class="slots">
    <view
      wx:for="{{slots}}"
      wx:key="index"
      class="slot {{item ? 'slot-filled' : ''}}"
    >{{item}}</view>
  </view>

  <!-- 游戏区：padding-top 占位保证 1:1 正方形 -->
  <view class="game-area">
    <!-- 连线 -->
    <view
      wx:for="{{lines}}"
      wx:key="index"
      class="line"
      style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.length}}px; transform: rotate({{item.angle}}deg);"
    ></view>
    <!-- 节点 -->
    <view
      wx:for="{{level.nodes}}"
      wx:key="id"
      class="node"
      style="left: {{item.x}}%; top: {{item.y}}%;"
      data-id="{{item.id}}"
      bindtap="onNodeTap"
    >
      <view class="node-float {{selectedMap[item.id] ? 'node-float-paused' : ''}}" style="animation-delay: {{index * 0.35}}s;">
        <view class="node-core {{selectedMap[item.id] ? 'node-selected' : ''}} {{shakeNodeId === item.id ? 'node-shake' : ''}} {{hintTargetId === item.id ? 'node-hint' : ''}}">
          <text class="node-emoji {{item.glyphs > 2 ? 'node-emoji-xwide' : item.glyphs > 1 ? 'node-emoji-wide' : ''}}">{{item.emoji}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部引导 -->
  <view class="tips">按顺序点击图案，组成四字成语</view>

  <!-- 结算弹层 -->
  <view class="result-mask" wx:if="{{showResult}}">
    <view class="confetti-layer">
      <view class="confetti-piece c0"><view class="dot"></view></view>
      <view class="confetti-piece c1"><view class="dot"></view></view>
      <view class="confetti-piece c2"><view class="dot"></view></view>
      <view class="confetti-piece c3"><view class="dot"></view></view>
      <view class="confetti-piece c4"><view class="dot"></view></view>
      <view class="confetti-piece c5"><view class="dot"></view></view>
      <view class="confetti-piece c6"><view class="dot"></view></view>
      <view class="confetti-piece c7"><view class="dot"></view></view>
      <view class="confetti-piece c8"><view class="dot"></view></view>
      <view class="confetti-piece c9"><view class="dot"></view></view>
      <view class="confetti-piece c10"><view class="dot"></view></view>
      <view class="confetti-piece c11"><view class="dot"></view></view>
    </view>
    <view class="result-card page-fade">
      <view class="result-emoji">🎉</view>
      <view class="result-idiom">{{level.idiom}}</view>
      <view class="result-explain">{{level.explanation}}</view>
      <view class="result-actions">
        <view class="btn btn-ghost result-btn" bindtap="replay">重玩本关</view>
        <view class="btn btn-primary result-btn" bindtap="nextLevel">{{isLastLevel ? '返回选关' : '下一关'}}</view>
      </view>
      <view class="result-select" bindtap="goSelect">去选择其他关卡 ›</view>
    </view>
  </view>
</view>

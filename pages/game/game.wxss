.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ========== 顶栏 ========== */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.level-badge {
  background: #fff;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-deep);
  box-shadow: var(--shadow-card);
}
.topbar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.08s ease;
}
.icon-btn:active {
  transform: scale(0.9) rotate(-120deg);
}
.icon-btn-emoji {
  font-size: 34rpx;
  line-height: 1;
}
.hint-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
  color: var(--brand-deep);
  font-weight: 600;
  font-size: 28rpx;
  transition: transform 0.08s ease;
}
.hint-btn:active {
  transform: scale(0.94);
}
.hint-btn-disabled {
  opacity: 0.5;
}
.hint-count {
  background: var(--accent);
  color: var(--ink);
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

/* ========== 四格填空 ========== */
.slots {
  display: flex;
  justify-content: center;
  gap: 22rpx;
  margin-bottom: 36rpx;
}
.slot {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 4rpx dashed #d8d3e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 66rpx;
  font-weight: 600;
  color: var(--ink);
  box-shadow: var(--shadow-card);
}
.slot-filled {
  border: 4rpx solid var(--success);
  background: #e9fbf9;
  animation: slot-flip 0.4s ease;
}
@keyframes slot-flip {
  0%   { transform: scale(0.6) rotateY(90deg); opacity: 0; }
  100% { transform: scale(1) rotateY(0deg); opacity: 1; }
}

/* ========== 游戏区 ========== */
.game-area {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 32rpx;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.7), var(--shadow-card);
  overflow: hidden;
}

/* 连线 */
.line {
  position: absolute;
  height: 8rpx;
  background: repeating-linear-gradient(
    90deg,
    var(--brand) 0,
    var(--brand) 16rpx,
    transparent 16rpx,
    transparent 28rpx
  );
  border-radius: 3rpx;
  transform-origin: 0 50%;
  pointer-events: none;
  opacity: 0.85;
}

/* 节点：外层负责定位居中，中层漂浮，内层样式与动效 */
.node {
  position: absolute;
  transform: translate(-50%, -50%);
}
.node-float {
  animation: float-y 3s ease-in-out infinite;
}
/* 已选中的节点停止漂浮：连线端点固定在圆的边缘，不再错位 */
.node-float-paused {
  animation-play-state: paused;
}
.node-core {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow:
    0 8rpx 20rpx rgba(61, 58, 80, 0.14),
    inset 0 -8rpx 0 rgba(61, 58, 80, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}
.node-emoji {
  font-size: 88rpx;
  line-height: 1;
}
/* 双字形 Emoji（如 🚫🐑）缩字号避免溢出 */
.node-emoji-wide {
  font-size: 58rpx;
  letter-spacing: -4rpx;
}
/* 三字形及以上（如 🐔🐔🐔）进一步缩小 */
.node-emoji-xwide {
  font-size: 44rpx;
  letter-spacing: -4rpx;
}
.node-core.node-selected {
  border: 6rpx solid var(--success);
  background: #e9fbf9;
  transform: scale(1.12);
  animation: node-pop 0.45s ease;
}
.node-core.node-shake {
  border: 6rpx solid var(--danger);
  animation: node-shake 0.4s ease;
}
.node-core.node-hint {
  animation: node-glow 1.5s ease infinite;
}
@keyframes node-pop {
  0%   { transform: scale(0.7); }
  55%  { transform: scale(1.28); }
  100% { transform: scale(1.12); }
}
@keyframes node-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-12rpx); }
  40% { transform: translateX(12rpx); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(8rpx); }
}
@keyframes node-glow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 138, 61, 0.55); }
  50%      { box-shadow: 0 0 0 22rpx rgba(255, 138, 61, 0); }
}

/* ========== 底部 ========== */
.tips {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-light);
  letter-spacing: 2rpx;
}

/* ========== 结算弹层 ========== */
.result-mask {
  position: fixed;
  inset: 0;
  background: rgba(61, 58, 80, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.result-card {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}
.result-emoji {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}
.result-idiom {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  margin-bottom: 20rpx;
}
.result-explain {
  font-size: 26rpx;
  color: var(--ink-light);
  line-height: 1.7;
  margin-bottom: 36rpx;
}
.result-actions {
  display: flex;
  gap: 20rpx;
}
.result-btn {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
}
.result-select {
  margin-top: 26rpx;
  color: var(--ink-light);
  font-size: 26rpx;
}

/* ========== 撒花粒子 ========== */
.confetti-layer {
  position: absolute;
  left: 50%;
  top: 36%;
  pointer-events: none;
}
.confetti-piece {
  position: absolute;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  opacity: 0;
  animation: confetti-fly 1.1s ease-out forwards;
}
.c0  { transform: rotate(0deg); }
.c1  { transform: rotate(30deg); }
.c2  { transform: rotate(60deg); }
.c3  { transform: rotate(90deg); }
.c4  { transform: rotate(120deg); }
.c5  { transform: rotate(150deg); }
.c6  { transform: rotate(180deg); }
.c7  { transform: rotate(210deg); }
.c8  { transform: rotate(240deg); }
.c9  { transform: rotate(270deg); }
.c10 { transform: rotate(300deg); }
.c11 { transform: rotate(330deg); }
.c0 .dot,  .c4 .dot,  .c8 .dot  { background: var(--brand); }
.c1 .dot,  .c5 .dot,  .c9 .dot  { background: var(--accent); }
.c2 .dot,  .c6 .dot,  .c10 .dot { background: var(--success); }
.c3 .dot,  .c7 .dot,  .c11 .dot { background: var(--danger); }
.c1 .dot,  .c5 .dot,  .c9 .dot  { animation-delay: 0.05s; }
.c2 .dot,  .c6 .dot,  .c10 .dot { animation-delay: 0.1s; }
.c3 .dot,  .c7 .dot,  .c11 .dot { animation-delay: 0.15s; }
@keyframes confetti-fly {
  0%   { transform: translateX(0) scale(1); opacity: 1; }
  100% { transform: translateX(200rpx) scale(0.3); opacity: 0; }
}
